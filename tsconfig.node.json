{
  // Tests and scripts, run in Node (Vitest, tsx): Node types, no DOM. The simulation code they import
  // (core/math, sailing, race, ai, sailors) is checked here too, so it stays free of browser APIs.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["tests", "scripts"]
}
